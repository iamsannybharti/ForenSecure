# Copy to .env and fill in. Nothing here is a real credential.
PORT=5000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgres://user:password@127.0.0.1:5432/forensecure

# --- Auth ---
# Required in production, minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Base URL of the frontend. Password-reset and invite links are built from it.
APP_URL=http://localhost:5173

# --- SMTP (optional) ---
# With SMTP_HOST empty, mail is logged to the server console instead of sent.
# Examples: smtp.gmail.com:587 (app password), smtp.sendgrid.net:587 (user
# "apikey"), email-smtp.<region>.amazonaws.com:587 (SES SMTP credentials).
SMTP_HOST=
SMTP_PORT=587
# Optional. Defaults to true on port 465, false otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ForenSecure <no-reply@example.com>
