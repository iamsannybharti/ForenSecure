{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    /* Unused-var checks are lint concerns, not build blockers — leaving them on
       fails `tsc && vite build` (and the CI deploy) on dead imports while real
       type errors still surface. Let ESLint own these; keep the build green. */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Self-checks run standalone under node, not through the bundler. */
  "exclude": ["src/**/*.selfcheck.ts"]
}
