{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://apiforensecure.forensecure.in/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://apiforensecure.forensecure.in/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
